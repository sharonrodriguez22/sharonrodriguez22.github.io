---
import SectionHead from './SectionHead.astro';
import { content, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
---

<section class="section" id="certs">
  <div class="wrap">
    <SectionHead kicker={t.certs.kicker} title={t.certs.title} blurb={t.certs.blurb} />

    <div class="grid">
      <div class="card">
        <p class="group-label">{t.nav.certs}</p>
        <ul>
          {
            t.certs.items.map((c) => (
              <li class="entry">
                <p class="entry-name">{c.name}</p>
                <p class="entry-sub">
                  <span>{c.org}</span>
                  <span class="entry-year">{c.year}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div style="display:flex;flex-direction:column;gap:16px">
        <div class="card">
          <p class="group-label">{t.education.title}</p>
          <ul>
            {
              t.education.items.map((e) => (
                <li class="entry">
                  <p class="entry-name">{e.name}</p>
                  <p class="entry-sub">
                    <span>{e.org}</span>
                    <span class="entry-year">{e.period}</span>
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card">
          <p class="group-label">{t.languages.title}</p>
          <ul>
            {
              t.languages.items.map((l) => (
                <li class="entry">
                  <p class="entry-name">{l.name}</p>
                  <p class="entry-sub">
                    <span>{l.level}</span>
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
